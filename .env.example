# ─── Deployment / Image ──────────────────────────────────────────────────────
DOMAIN=your-domain.com               # required in production; used by Caddy for HTTPS
CORS_ORIGIN="https://minepanel.xyz"  # required in production; exact frontend origin, never '*'
MINEPANEL_IMAGE=ghcr.io/minepanelproject/minepanel-backend:latest

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-secure-password-here
DATABASE_URL="postgresql://minepanel:${POSTGRES_PASSWORD}@postgres:5432/minepanel"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here-make-it-long-and-random
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Auth / Encryption ────────────────────────────────────────────────────────
# Must be 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# One-time first-admin bootstrap secret sent as X-Setup-Token.
# Configure a random value explicitly; if omitted, the backend generates and logs
# one base64url token once per incomplete process.
SETUP_TOKEN=

REQUIRE_ADMIN_APPROVAL=true          # true = new users start as PENDING, admin must approve
LOGIN_THROTTLE_LIMIT=5               # max login attempts per window
LOGIN_THROTTLE_TTL_MS=10000          # window duration in ms (default: 10s)

# ─── Docker / Host paths ──────────────────────────────────────────────────────
# DOCKER_SOCKET here names the HOST socket path, used as the Compose bind
# source (rootless example: /run/user/1000/docker.sock). Inside the backend
# container the socket is always mounted at the fixed /var/run/docker.sock; the
# compose file sets the backend env to that container path regardless of this
# value. If unset, Compose defaults to /var/run/docker.sock.
DOCKER_SOCKET="/var/run/docker.sock"
DOCKER_NETWORK="minepanel_network"

# Required in production Compose. The setup wizards write $HOME/.minepanel/mc-data
# by default. Must be a non-empty absolute path with no surrounding whitespace
# and no . or .. path segments. Mounted read-only into the backend container.
# MC_DATA_PATH_HOST=/absolute/path/to/mc-data

# Direct backend execution only. Compose overrides this with the fixed /mc-data
# mount and passes the host root as MC_DATA_BIND_SOURCE (see below).
MC_DATA_PATH="/mc-data"
# Host-side bind source for Minecraft containers (Compose only; derived from
# MC_DATA_PATH_HOST). Kept separate from MC_DATA_PATH so a Windows host path is
# passed verbatim to the Docker daemon instead of being parsed as a Linux path.
# MC_DATA_BIND_SOURCE=/absolute/path/to/mc-data

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                 # development | production
PANEL_NAME="My MinePanel"
PANEL_DESCRIPTION="Minecraft server management panel API"
PANEL_VERSION="1.0"

# ─── Minecraft limits ────────────────────────────────────────────────────────
MC_PORT_MIN=25565
MC_PORT_MAX=25665
MIN_FREE_DISK_MB=2048
MAX_MEMORY_RATIO=0.90
STOP_WARN_SECONDS=30                 # seconds to warn players before graceful shutdown (0-300, default 30)

# ─── Volume / network names (overridable for disposable tests) ───────────────
POSTGRES_VOLUME_NAME=minepanel-postgres-data
CADDY_DATA_VOLUME_NAME=minepanel-caddy-data
CADDY_CONFIG_VOLUME_NAME=minepanel-caddy-config
MINEPANEL_APP_NETWORK=minepanel-app-network

# ─── SMTP (optional — enables email features) ────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# ─── Minecraft linking (optional) ────────────────────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
